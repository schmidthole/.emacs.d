;;; agent-test.el --- project agent tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'agent)

(ert-deftest agent-new-launches-selected-program-in-project ()
  (dolist (program '(codex claude pi))
    (let ((agent-program 'codex)
          (buffers nil)
          (launches nil))
      (unwind-protect
          (save-window-excursion
            (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
                      ((symbol-function 'completing-read)
                       (lambda (prompt choices predicate require-match initial history default)
                         (should (equal prompt "agent program: "))
                         (should (equal choices '("claude" "codex" "pi")))
                         (should require-match)
                         (should-not predicate)
                         (should-not initial)
                         (should-not history)
                         (should (equal default "codex"))
                         (symbol-name program)))
                      ((symbol-function 'project-current)
                       (lambda (&rest _) '(transient . "/private/tmp/")))
                      ((symbol-function 'project-name) (lambda (_) "example"))
                      ((symbol-function 'ghostel-exec)
                       (lambda (buffer shell args &rest _)
                         (push buffer buffers)
                         (with-current-buffer buffer
                           (push (list shell args default-directory) launches)
                           (setq major-mode 'ghostel-mode)))))
              (let ((first (call-interactively #'agent-new))
                    (second (agent-new program)))
                (should (eq agent-program 'codex))
                (should (equal (buffer-name first) "*agent: example*"))
                (should (equal (buffer-name second) "*agent: example*<2>"))
                (should (= (length launches) 2))
                (dolist (launch launches)
                  (should (equal (car launch) (or (getenv "SHELL") shell-file-name)))
                  (should (equal (seq-take (cadr launch) 3) '("-l" "-i" "-c")))
                  (should (string-prefix-p (concat "exec " (symbol-name program))
                                           (nth 3 (cadr launch))))
                  (should (equal (nth 2 launch) "/private/tmp/"))
                  (when (eq program 'codex)
                    (should (string-match-p "tui.notifications" (nth 3 (cadr launch))))
                    (should (string-match-p "osc9" (nth 3 (cadr launch))))))
                (with-current-buffer first
                  (should agent-mode)
                  (should-not ghostel-kill-buffer-on-exit)
                  (agent-rename "investigation")
                  (setq default-directory "/")
                  (should (equal agent-project-root "/private/tmp/"))
                  (should (equal agent-project-name "example"))
                  (rename-buffer "manual rename")
                  (should (equal agent-project-root "/private/tmp/"))))))
        (mapc #'kill-buffer buffers)))))

(ert-deftest agent-new-cancellation-does-not-start-a-launch ()
  (cl-letf (((symbol-function 'completing-read)
             (lambda (&rest _) (signal 'quit nil)))
            ((symbol-function 'project-current)
             (lambda (&rest _) (ert-fail "unexpected project lookup"))))
    (should (eq (condition-case nil
                    (call-interactively #'agent-new)
                  (quit 'cancelled))
                'cancelled))))

(ert-deftest agent-new-rejects-unknown-program-before-creating-buffer ()
  (let ((agent-program 'unknown))
    (cl-letf (((symbol-function 'project-current)
               (lambda (&rest _) '(transient . "/private/tmp/")))
              ((symbol-function 'project-name) (lambda (_) "example"))
              ((symbol-function 'generate-new-buffer)
               (lambda (&rest _) (ert-fail "unexpected buffer creation"))))
      (should-error (agent-new) :type 'user-error))))

(ert-deftest agent-new-cleans-up-failed-launch ()
  (let (buffer)
    (save-window-excursion
      (cl-letf (((symbol-function 'require) (lambda (&rest _) t))
                ((symbol-function 'project-current)
                 (lambda (&rest _) '(transient . "/private/tmp/")))
                ((symbol-function 'project-name) (lambda (_) "example"))
                ((symbol-function 'ghostel-exec)
                 (lambda (created &rest _)
                   (setq buffer created)
                   (error "launch failed"))))
        (should-error (agent-new))
        (should (bufferp buffer))
        (should-not (buffer-live-p buffer))))))

(ert-deftest agent-renaming-rejects-nonagents-and-empty-names ()
  (with-temp-buffer
    (should-error (agent-rename "example") :type 'user-error)
    (should-error (agent-mode 1) :type 'user-error)
    (should-not agent-mode)
    (setq major-mode 'ghostel-mode)
    (agent-mode 1)
    (should-error (agent-rename "  ") :type 'user-error)))

(ert-deftest agent-notifications-ring-once-until-acknowledged ()
  (with-temp-buffer
    (setq major-mode 'ghostel-mode)
    (agent-mode 1)
    (let ((rings 0)
          (ring-bell-function #'ignore)
          (visible-bell t))
      (cl-letf (((symbol-function 'ding)
                 (lambda (&rest _)
                   (should-not ring-bell-function)
                   (should-not visible-bell)
                   (cl-incf rings))))
        (funcall ghostel-notification-function "finished" "done")
        (funcall ghostel-notification-function "input" "waiting")
        (should agent-attention)
        (should (= rings 1))
        (run-hooks 'post-command-hook)
        (should-not agent-attention)
        (agent--exited (current-buffer) "finished")
        (should agent-attention)
        (should (= rings 2))))))

(ert-deftest agent-switch-filters-orders-annotates-and-acknowledges ()
  (let ((first (generate-new-buffer "agent first"))
        (second (generate-new-buffer "agent second"))
        (ordinary (generate-new-buffer "ordinary")))
    (unwind-protect
        (save-window-excursion
          (dolist (buffer (list first second))
            (with-current-buffer buffer
              (setq major-mode 'ghostel-mode)
              (agent-mode 1)
              (setq agent-project-name "example")))
          (with-current-buffer second (setq agent-attention t))
          (cl-letf (((symbol-function 'buffer-list)
                     (lambda (&rest _) (list ordinary first second)))
                    ((symbol-function 'completing-read)
                     (lambda (_prompt collection &rest _)
                       (should (equal collection '("agent second" "agent first")))
                       (should (equal (agent--annotation "agent second")
                                      "  example  attention"))
                       "agent second")))
            (should (equal (agent--buffers) (list second first)))
            (agent-switch)
            (should (eq (current-buffer) second))
            (should-not agent-attention)))
      (mapc #'kill-buffer (list first second ordinary)))))

(ert-deftest agent-switch-rejects-empty-list ()
  (cl-letf (((symbol-function 'agent--buffers) (lambda () nil)))
    (should-error (agent-switch) :type 'user-error)))

(ert-deftest agent-mode-disabling-removes-local-notifications ()
  (with-temp-buffer
    (setq major-mode 'ghostel-mode)
    (agent-mode 1)
    (agent-mode -1)
    (should-not (local-variable-p 'ghostel-notification-function))
    (should-not (local-variable-p 'ghostel-kill-buffer-on-exit))
    (should-not (memq #'agent--exited ghostel-exit-functions))
    (should-not (memq #'agent--acknowledge post-command-hook))))

(ert-deftest agent-keys-override-terminal-input-bindings ()
  (with-temp-buffer
    (setq major-mode 'ghostel-mode)
    (use-local-map (define-keymap "M-i" #'ignore))
    (agent-mode 1)
    (should (eq (key-binding (kbd "M-i a n")) #'agent-new))
    (should (eq (key-binding (kbd "M-i a a")) #'agent-switch))
    (should (eq (key-binding (kbd "M-i a r")) #'agent-rename))))

;;; agent-test.el ends here
