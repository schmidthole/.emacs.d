     (fg-main "#EFEFEF")
     (fg-active "#FFFFFF")
     (fg-mode-line-active "#EFEFEF")
     (bg-mode-line-active "#1C1C1C")
     (fg-mode-line-inactive "#5D5D5D")
     (bg-mode-line-inactive "#1C1C1C")
