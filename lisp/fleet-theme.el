     `(eat-term-color-10 ((,c :foreground "#99DDCC" :background "#99DDCC")))
     `(eat-term-color-11 ((,c :foreground "#ECD6A8" :background "#ECD6A8")))
     `(eat-term-color-12 ((,c :foreground "#B4D4FC" :background "#B4D4FC")))
