     (builtin "#78D0BD")
     (comment "#898989")
     (string "#D898D8")
     (fnname "#E5C995")
     (type "#94C1FA")
     (variable "#EFEFEF")
     (docstring "#898989")
     (constant "#E5C995")
     
     (cursor "#FFFFFF")))
