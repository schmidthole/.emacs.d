     `(vterm-color-green ((,c :foreground "#78D0BD" :background "#78D0BD")))
     `(vterm-color-yellow ((,c :foreground "#E5C995" :background "#E5C995")))
     `(vterm-color-blue ((,c :foreground "#94C1FA" :background "#94C1FA")))
