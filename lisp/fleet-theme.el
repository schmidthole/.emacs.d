     (bg-tab-current bg-main)
     (bg-tab-other "#181818")
     (fg-prompt "#ECA775")
     (bg-prompt "#181818")
     (bg-hover-secondary "#353535")
     (bg-completion "#163764")
     (fg-completion "#EFEFEF")
     (bg-region "#2A2A2A")
     (fg-region unspecified)

