# Follow macOS appearance using the matching Modus palette.
theme = light:Modus Operandi,dark:Modus Vivendi
font-family = JetBrains Mono
font-size = 13
font-thicken = true
mouse-hide-while-typing = true

macos-titlebar-style = tabs
window-padding-x = 4
window-padding-y = 4
window-padding-balance = true

custom-shader = ~/.config/ghostty/shaders/cursor_warp.glsl

# Jumpa: use a standard F6 sequence through Herdr/tmux and terminal Emacs.
# Ctrl+semicolon has no legacy control character of its own.
keybind = ctrl+semicolon=text:\x1b[17~

# tmux shortcuts send f12 followed by the action key
keybind = super+h=text:\x1b[24~h
keybind = super+j=text:\x1b[24~j
keybind = super+k=text:\x1b[24~k
keybind = super+l=text:\x1b[24~l
keybind = super+shift+h=text:\x1b[24~H
keybind = super+shift+j=text:\x1b[24~J
keybind = super+shift+k=text:\x1b[24~K
keybind = super+shift+l=text:\x1b[24~L
keybind = super+d=text:\x1b[24~\\
keybind = super+shift+d=text:\x1b[24~-
keybind = super+enter=text:\x1b[24~m
keybind = super+m=text:\x1b[24~m
keybind = super+t=text:\x1b[24~c
keybind = super+digit_1=text:\x1b[24~1
keybind = super+digit_2=text:\x1b[24~2
keybind = super+digit_3=text:\x1b[24~3
keybind = super+digit_4=text:\x1b[24~4
keybind = super+digit_5=text:\x1b[24~5
keybind = super+digit_6=text:\x1b[24~6
keybind = super+digit_7=text:\x1b[24~7
keybind = super+digit_8=text:\x1b[24~8
keybind = super+digit_9=text:\x1b[24~9
keybind = super+[=text:\x1b[24~[
keybind = super+]=text:\x1b[24~]
keybind = super+r=text:\x1b[24~n
keybind = super+w=text:\x1b[24~q
keybind = super+shift+w=text:\x1b[24~x

# Herdr space cycling: F12+Shift+u / F12+u, leaving Meta keys for Emacs.
keybind = super+shift+n=text:\x1b[24~U
keybind = super+shift+p=text:\x1b[24~u

# Herdr rename space: F12+Shift+w.
keybind = super+s=text:\x1b[24~W

# Herdr new space: F12+Shift+n.
keybind = super+shift+s=text:\x1b[24~N

# Herdr sidebar toggle: F12+b.
keybind = super+o=text:\x1b[24~b
